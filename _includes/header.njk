<nav>
  <a href="{{ '/' | relativeUrl }}" class="logo">
    <img class="logo-dark" src="/images/logo-blur-white.svg" alt="CodeMade" />
    <img class="logo-light" src="/images/logo-blur.svg" alt="" />
  </a>
  <div class="nav-actions">
  {% if site.header.nav_links and site.header.has_nav %}
  <ul>
    {% for action in site.header.nav_links %}
    <li>
      <a href="{{ action.url | relativeUrl }}"
        {% if action.new_window | isNotEmpty %}target="_blank" rel="noopener"{% endif %}>{{ action.label }}</a>
    </li>
    {% endfor %}
  </ul>
  {% endif %}
    <button class="theme-control" type="button" data-theme-toggle aria-label="Theme: Light" title="Theme: Light">☀️</button>
  </div>
</nav>
