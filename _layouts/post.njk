---
layout: body
---

<article class="post-page">
  <header class="post-page-header">
    {% if image | isNotEmpty %}
    <div class="post-page-thumb">
      <img src="{{ image | relativeUrl }}" alt="{{ title }}" />
    </div>
    {% endif %}
    {% set post = page %}
    {% set date_type = 'long' %}
    {% include "blog_post_footer.njk" %}
    <h1 class="post-page-title">{{ title }}</h1>
    {% if subtitle | isNotEmpty %}
    <p class="post-page-subtitle">{{ subtitle }}</p>
    {% endif %}
  </header>
  <div class="post-page-content">
    {{ content | safe }}
  </div>
  {% set previous_post = collections.posts | getPreviousCollectionItem(page) %}
  {% set next_post = collections.posts | getNextCollectionItem(page) %}
  {% if previous_post or next_post %}
  <nav class="post-navigation" aria-label="Adjacent blog posts">
    {% if previous_post %}
    <a class="post-navigation-prev" href="{{ previous_post.url | relativeUrl }}" rel="prev">
      <span aria-hidden="true">⬅&#xFE0E;</span>
      <span>{{ previous_post.data.title }}</span>
    </a>
    {% endif %}
    {% if next_post %}
    <a class="post-navigation-next" href="{{ next_post.url | relativeUrl }}" rel="next">
      <span>{{ next_post.data.title }}</span>
      <span aria-hidden="true">➡&#xFE0E;</span>
    </a>
    {% endif %}
  </nav>
  {% endif %}
  <div id="comments-container"></div>
  <script>
    window.COMMENTS_CONFIG = {
      "theme": document.documentElement.dataset.theme,
      "tenant": 'codemade-net',
      "title": '{{ title | dump }}',
      "slug": '{{ page.fileSlug }}',
      "containerId": 'comments-container'
    }
  </script>
</article>
